generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  BUYER
  ADMIN
  PRO_BUYER
}

enum StoreStatus {
  ACTIVE
  WARNING
  COD_BLOCKED
  PAUSED
  DELISTED
  SUSPENDED
  BANNED
}

enum PaymentStatus {
  PENDING
  VALIDATED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  STORE_ORDER
  WALLET_TOPUP
  PRO_SUBSCRIPTION
  AD_BOOKING
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUSED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  role         Role                 @default(SELLER)
  store        Store?
  sessions     Session[]
  payments     PaymentTransaction[]
  createdAt    DateTime             @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Store {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  customDomain   String?              @unique
  template       String               // "classic" | "modern" -- fixed built-in templates
  status         StoreStatus          @default(ACTIVE)
  kycVerified    Boolean              @default(false)
  ownerId        String               @unique
  owner          User                 @relation(fields: [ownerId], references: [id])
  products       Product[]
  orders         Order[]
  payments       PaymentTransaction[]
  ledgerEntries  LedgerEntry[]
  
  // Wallet Balance (in BDT ৳)
  walletBalance  Decimal              @default(4850.00) @db.Decimal(10, 2)
  walletHolds    Decimal              @default(0.00) @db.Decimal(10, 2)
  
  createdAt      DateTime             @default(now())
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String      @default("")
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  image       String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())

  @@index([storeId])
}

model Order {
  id              String              @id @default(cuid())
  orderNumber     String              @unique // e.g. "ORD-10024"
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  shippingAddress String
  shippingCity    String              @default("Dhaka")
  
  totalAmount     Decimal             @db.Decimal(10, 2)
  platformFee     Decimal             @db.Decimal(10, 2) // Calculated split platform commission
  sellerNet       Decimal             @db.Decimal(10, 2) // Total - platformFee
  
  paymentMethod   String              // "SSLCOMMERZ" | "COD"
  status          OrderStatus         @default(PENDING_PAYMENT)
  payment         PaymentTransaction?
  items           OrderItem[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([storeId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // Snapshot of unit price at order time
}

model PaymentTransaction {
  id             String         @id @default(cuid())
  tranId         String         @unique // SSLCommerz unique transaction ID, e.g. "SF-ORD-xxx", "SF-TOPUP-xxx"
  valId          String?        // SSLCommerz validation ID
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("BDT")
  purpose        PaymentPurpose
  status         PaymentStatus  @default(PENDING)
  
  // Relations
  orderId        String?        @unique
  order          Order?         @relation(fields: [orderId], references: [id])
  storeId        String?
  store          Store?         @relation(fields: [storeId], references: [id])
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  
  // Gateway Metadata
  cardType       String?        // e.g. "BKASH-BKash", "VISA-City Bank"
  bankTranId     String?
  rawValidation  Json?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tranId])
  @@index([status])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactionId String?  // Reference to tranId or orderNumber
  entryType     String   // "ORDER_SPLIT_SETTLEMENT" | "PLATFORM_FEE" | "WALLET_TOP_UP" | "COD_FEE_HOLD"
  description   String
  debit         Decimal? @db.Decimal(10, 2)
  credit        Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@index([storeId])
}
