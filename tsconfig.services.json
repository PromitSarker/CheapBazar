{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "services/**/src/**/*.ts", "services/**/tests/**/*.ts"],
  "exclude": ["node_modules", "services/**/generated"]
}
