{
  "name": "cheap-bazar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push && node prisma/seed.mjs",
    "svc:ledger": "tsx services/ledger-service/src/index.ts",
    "prisma:ledger": "prisma generate --schema services/ledger-service/prisma/schema.prisma",
    "db:push:ledger": "prisma db push --schema services/ledger-service/prisma/schema.prisma",
    "typecheck:services": "tsc -p tsconfig.services.json",
    "test:ledger": "tsx --test services/ledger-service/tests/ledger.test.ts",
    "svc:identity": "tsx services/identity-service/src/index.ts",
    "prisma:identity": "prisma generate --schema services/identity-service/prisma/schema.prisma",
    "db:push:identity": "prisma db push --schema services/identity-service/prisma/schema.prisma",
    "test:identity": "tsx --test services/identity-service/tests/identity.test.ts",
    "svc:catalog": "tsx services/catalog-service/src/index.ts",
    "prisma:catalog": "prisma generate --schema services/catalog-service/prisma/schema.prisma",
    "db:push:catalog": "prisma db push --schema services/catalog-service/prisma/schema.prisma",
    "test:catalog": "tsx --test services/catalog-service/tests/catalog.test.ts",
    "test:services": "tsx --test services/*/tests/*.test.ts",
    "svc:order": "tsx services/order-service/src/index.ts",
    "prisma:order": "prisma generate --schema services/order-service/prisma/schema.prisma",
    "db:push:order": "prisma db push --schema services/order-service/prisma/schema.prisma",
    "test:order": "tsx --test services/order-service/tests/order.test.ts",
    "svc:aggregator": "tsx services/aggregator-service/src/index.ts",
    "prisma:aggregator": "prisma generate --schema services/aggregator-service/prisma/schema.prisma",
    "db:push:aggregator": "prisma db push --schema services/aggregator-service/prisma/schema.prisma",
    "test:aggregator": "tsx --test services/aggregator-service/tests/aggregator.test.ts",
    "svc:notification": "tsx services/notification-service/src/index.ts",
    "prisma:notification": "prisma generate --schema services/notification-service/prisma/schema.prisma",
    "db:push:notification": "prisma db push --schema services/notification-service/prisma/schema.prisma",
    "test:notification": "tsx --test services/notification-service/tests/notification.test.ts",
    "svc:ad": "tsx services/ad-service/src/index.ts",
    "prisma:ad": "prisma generate --schema services/ad-service/prisma/schema.prisma",
    "db:push:ad": "prisma db push --schema services/ad-service/prisma/schema.prisma",
    "test:ad": "tsx --test services/ad-service/tests/ad.test.ts",
    "svc:payment": "tsx services/payment-billing-service/src/index.ts",
    "prisma:payment": "prisma generate --schema services/payment-billing-service/prisma/schema.prisma",
    "db:push:payment": "prisma db push --schema services/payment-billing-service/prisma/schema.prisma",
    "test:payment": "tsx --test services/payment-billing-service/tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "prisma": "^5.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  }
}
