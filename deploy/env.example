# Copy to deploy/.env via deploy/gen-env.sh (it fills the secrets). Never commit deploy/.env.
PG_PORT=54330
PG_PASSWORD=change-me
# Shared bearer token for service-to-service and web-to-service calls
INTERNAL_AUTH_SECRET=change-me
# HMAC secrets for the courier webhook
COURIER_WEBHOOK_SECRET=change-me
# Public URL of the web app (used for payment return links)
APP_URL=http://103.228.38.77:3000
BILLING_PUBLIC_URL=
# COD-first: online payments off until the owner decides
ONLINE_PAYMENTS_ENABLED=false
ALLOW_SELLER_FINALIZE=true
# SSLCommerz (only used when ONLINE_PAYMENTS_ENABLED=true)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# Notifications: leave empty and messages are logged as SKIPPED
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
RESEND_API_KEY=
MAIL_FROM=
