DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storeforge?schema=public"

# SSLCommerz Gateway Config
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
SSLCOMMERZ_IS_LIVE="false"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform Revenue Model
PLATFORM_FEE_PERCENTAGE="5.0"

# --- Google ads (all optional; leave empty and no ad code is loaded) -----------------------------
# Website, Google AdSense: publisher id + one ad-unit id per placement (AdSense > Ads > By ad unit).
# Also set SUPPORT_EMAIL: it is published on /privacy and /about, which AdSense requires.
ADSENSE_CLIENT=""            # ca-pub-1234567890123456
ADSENSE_SLOT_HOME=""         # numeric ad-unit ids, e.g. 1234567890
ADSENSE_SLOT_BROWSE=""
ADSENSE_SLOT_BROWSE_SIDE=""
ADSENSE_SLOT_STORE=""
ADSENSE_ENABLED="true"       # set false to switch AdSense off without removing the ids
SUPPORT_EMAIL="support@cheapbazar.org"
# App, Google AdMob (AdSense cannot serve inside a native app). The app id itself goes in
# mobile/android/app/src/main/AndroidManifest.xml (needs a new APK); unit ids below can change any time.
ADMOB_ENABLED="false"
ADMOB_BANNER_HOME=""         # ca-app-pub-1234567890123456/1234567890
ADMOB_BANNER_BROWSE=""
ADMOB_BANNER_PRODUCT=""
ADMOB_USE_TEST_UNITS="false" # true = Google sample ads (to check the flow only; never earns)
