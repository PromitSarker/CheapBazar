// catalog-service: products, retail price, wholesale MOQ + volume tiers, stock,
// and the time-limited stock reservation engine. Owns catalog_db.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductChannel {
  RETAIL
  WHOLESALE
  BOTH
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
}

model Product {
  id             String         @id @default(cuid())
  storeId        String
  name           String
  description    String         @default("")
  price          Decimal        @db.Decimal(10, 2)
  // Units available to sell RIGHT NOW (on-hand minus reservations).
  stock          Int            @default(0)
  image          String?
  // Extra gallery images (image stays the cover = images[0] when both are set).
  images         String[]       @default([])
  // Admin-managed taxonomy. parentCategoryId is denormalised (a category's parent never changes).
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentCategoryId String?
  brand          String?
  unit           String?        // pack size / unit, e.g. "500 g", "Size M"
  compareAtPrice Decimal?       @db.Decimal(10, 2) // "was" price; must be above price
  channel        ProductChannel @default(RETAIL)
  moq            Int            @default(1)
  wholesalePrice Decimal?       @db.Decimal(10, 2)
  tiers          PriceTier[]
  items          ReservationItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([storeId, createdAt])
  @@index([channel])
  @@index([categoryId])
  @@index([parentCategoryId])
}

// Two-level, admin-only category tree (top-level + sub-category). Sellers can only pick from it.
model Category {
  id         String     @id @default(cuid())
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  slug       String     @unique
  nameEn     String
  nameBn     String     @default("")
  icon       String     @default("category") // Material icon key resolved by the apps
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)
  products   Product[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([parentId, sortOrder])
}

// Volume discount: from minQty units the unit price is unitPrice.
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@unique([productId, minQty])
}

model StockReservation {
  id         String            @id @default(cuid())
  orderRef   String            @unique
  storeId    String
  status     ReservationStatus @default(HELD)
  expiresAt  DateTime?
  items      ReservationItem[]
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  @@index([status, expiresAt])
}

model ReservationItem {
  id            String           @id @default(cuid())
  reservationId String
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int

  @@index([reservationId])
}

model OutboxMessage {
  id          String    @id
  eventId     String
  consumer    String
  eventType   String
  envelope    Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, availableAt])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())
}
