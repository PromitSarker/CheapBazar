// payment-billing-service: gateway payments (SSLCommerz, on hold behind ONLINE_PAYMENTS_ENABLED),
// manual (bKash/Nagad/bank) payments reviewed by an admin, the Buyer Pro monthly subscription (the only plan:
// sellers pay nothing) and invoices. The buyer fee is the platform (admin) revenue. Owns payment_billing_db.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentPurpose {
  STORE_ORDER
  WALLET_TOPUP
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING   // session created, waiting for the gateway
  CAPTURED  // gateway-verified (server-to-server) and amount matched
  FAILED    // gateway reported failure (a later VERIFIED payment can still capture it)
  CANCELLED // buyer abandoned at the gateway (same: can still capture if the gateway says paid)
  EXPIRED   // session ran out without a result
  REFUNDED  // fully refunded
  CHARGEBACK // disputed by the buyer's bank; money clawed back
}

enum RefundStatus {
  INITIATED // accepted by the gateway (settles asynchronously)
  FAILED
}

// Buyer Pro is the ONLY plan: a wholesale buyer pays a monthly fee, sellers pay nothing.
enum PlanCode {
  BUYER_PRO
}

enum SubscriptionStatus {
  ACTIVE
  GRACE     // the paid month ended: access continues until graceEndsAt while the buyer pays again
  LAPSED    // wholesale prices locked
}

enum InvoiceStatus {
  PAID
  VOID
}

enum ManualStatus {
  PENDING
  APPROVED
  REJECTED
}

// One gateway charge attempt. `amount` is always decided server-side (from the order,
// the plan price or a validated top-up amount), never taken from the caller blindly.
model Payment {
  id             String         @id @default(cuid())
  tranId         String         @unique
  idempotencyKey String         @unique
  purpose        PaymentPurpose
  status         PaymentStatus  @default(PENDING)
  gateway        String         @default("SSLCOMMERZ")
  amount         Decimal        @db.Decimal(12, 2)
  fee            Decimal?       @db.Decimal(12, 2) // platform fee (orders)
  net            Decimal?       @db.Decimal(12, 2) // seller net (orders)
  currency       String         @default("BDT")
  orderNumber    String?
  storeId        String?
  userId         String?
  plan           PlanCode?
  buyerName      String?
  buyerEmail     String?
  buyerPhone     String?
  gatewayUrl     String?
  sessionKey     String?
  valId          String?
  bankTranId     String?
  cardType       String?
  rawValidation  Json?
  // Validation attempts that did NOT match (wrong amount/currency/tran id). They never
  // change the status, so a later valid callback is never blocked by an earlier bad one.
  validationFailures Int       @default(0)
  lastError      String?
  failureReason  String?
  refundedAmount Decimal        @default(0) @db.Decimal(12, 2)
  expiresAt      DateTime
  capturedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refunds        Refund[]

  @@index([orderNumber])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model Refund {
  id            String       @id @default(cuid())
  refundRef     String       @unique
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id])
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  requestedBy   String
  status        RefundStatus
  gatewayRefId  String?
  error         String?
  createdAt     DateTime     @default(now())
}

// A payment the merchant/buyer made outside a gateway (bKash/Nagad/Rocket/bank/cash) and
// is waiting for an admin to verify. (method, trxId) is unique so one real transfer can
// never be claimed twice.
model ManualPayment {
  id             String         @id @default(cuid())
  reference      String         @unique // MP-XXXXXXXX: the ledger idempotency reference
  idempotencyKey String         @unique
  purpose        PaymentPurpose // WALLET_TOPUP | SUBSCRIPTION
  method         String         // BKASH | NAGAD | ROCKET | BANK | CASH
  trxId          String
  senderNumber   String?
  proofUrl       String?
  amount         Decimal        @db.Decimal(12, 2)
  storeId        String?
  userId         String?
  plan           PlanCode?
  status         ManualStatus   @default(PENDING)
  reviewedBy     String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@unique([method, trxId])
  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
}

model Plan {
  code        PlanCode @id
  name        String
  price       Decimal  @db.Decimal(12, 2)
  periodDays  Int      @default(30)
  graceDays   Int      @default(3)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// One subscription per (plan, buyer). The buyer pays again each period (gateway or manual payment).
model Subscription {
  id                 String             @id @default(cuid())
  plan               PlanCode
  subjectKey         String             // "user:<id>"
  userId             String
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           Invoice[]

  @@unique([plan, subjectKey])
  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  plan           PlanCode
  amount         Decimal       @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  method         String        // GATEWAY | MANUAL
  paymentRef     String        // ledger tx key / tranId / manual reference
  status         InvoiceStatus @default(PAID)
  createdAt      DateTime      @default(now())

  // A period can be billed only once, whatever retries or replays happen.
  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId, createdAt])
}

model OutboxMessage {
  id          String    @id
  eventId     String
  consumer    String
  eventType   String
  envelope    Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, availableAt])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())
}
