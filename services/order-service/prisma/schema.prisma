// order-service: carts-to-orders. Orchestrates the checkout saga across catalog,
// ledger, billing and identity; owns the order state machine and the immutable
// fee snapshot. Owns orders_db.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PLACING         // transient saga state; never shown to users
  PENDING_PAYMENT // online order waiting for the gateway
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUSED
}

enum OrderType {
  RETAIL
  WHOLESALE
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  storeId              String
  storeSlug            String
  storeName            String
  ownerId              String           // seller user id (self-purchase guard, notifications)
  buyerId              String?          // set for logged-in buyers (always for wholesale)
  buyerName            String
  buyerEmail           String
  buyerPhone           String
  shippingAddress      String
  shippingCity         String           @default("Dhaka")
  orderType            OrderType        @default(RETAIL)
  paymentMethod        String           // "COD" | "SSLCOMMERZ"
  paymentRef           String?          // gateway tran id once paid
  status               OrderStatus      @default(PLACING)
  totalAmount          Decimal          @db.Decimal(12, 2)
  platformFee          Decimal          @db.Decimal(12, 2)
  sellerNet            Decimal          @db.Decimal(12, 2)
  idempotencyKey       String?          @unique
  reservationExpiresAt DateTime?
  courierName          String?
  trackingNumber       String?
  items                OrderItem[]
  feeSnapshot          OrderFeeSnapshot?
  events               OrderEvent[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([storeId, createdAt])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) // snapshot at order time

  @@index([orderId])
}

// Locked at creation: later changes to fee settings never alter an old order.
model OrderFeeSnapshot {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderType   OrderType
  feePercent  Decimal   @db.Decimal(5, 2)
  totalAmount Decimal   @db.Decimal(12, 2)
  platformFee Decimal   @db.Decimal(12, 2)
  sellerNet   Decimal   @db.Decimal(12, 2)
  codFeeHold  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  source     String       // SELLER | COURIER | ADMIN | SYSTEM | BUYER
  actor      String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model OutboxMessage {
  id          String    @id
  eventId     String
  consumer    String
  eventType   String
  envelope    Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, availableAt])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())
}
