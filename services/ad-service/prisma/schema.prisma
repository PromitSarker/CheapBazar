// ad-service: ad slots, bookings (no-overlap date reservations), moderation, charging
// via the ledger, activation/expiry and the active-ads cache. Owns ads_db.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdPlacement {
  AGGREGATOR
  STOREFRONT
}

enum BookingStatus {
  PENDING_REVIEW // holds its dates, not charged yet
  APPROVED       // approved by admin, waiting for charge and/or start date
  ACTIVE         // charged and live (in the ads cache)
  SUSPENDED      // store was PAUSED/DELISTED/SUSPENDED/BANNED: not served, no refund/extension
  EXPIRED        // ran to its end date
  REJECTED       // rejected by admin, or never reviewed in time, or could not be charged
  CANCELLED      // withdrawn by the merchant before review
}

enum ChargeState {
  NONE
  PENDING // approved, ledger charge not confirmed yet (retried by the worker)
  CHARGED
}

// An inventory slot. `capacity` = how many ads may run on the same day (1 = exclusive).
model AdSlot {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  placement   AdPlacement
  capacity    Int         @default(1)
  pricePerDay Decimal     @db.Decimal(12, 2)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings AdBooking[]
}

model AdBooking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  slotId        String
  slot          AdSlot        @relation(fields: [slotId], references: [id])
  storeId       String
  ownerId       String
  headline      String
  imageUrl      String
  targetUrl     String
  // Inclusive calendar days in Bangladesh time (Asia/Dhaka).
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  days          Int
  pricePerDay   Decimal       @db.Decimal(12, 2) // locked at booking time
  totalPrice    Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING_REVIEW)
  chargeState   ChargeState   @default(NONE)
  ledgerTxId    String?
  reviewedBy    String?
  reviewNote    String?
  reviewedAt    DateTime?
  idempotencyKey String?      @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slotId, status, startDate, endDate])
  @@index([storeId, status])
  @@index([status, startDate])
}

// Last known store status per store (out-of-order safe: older events are ignored).
model StoreAdState {
  storeId   String   @id
  status    String
  eventAt   DateTime
  updatedAt DateTime @updatedAt
}

model OutboxMessage {
  id          String    @id
  eventId     String
  consumer    String
  eventType   String
  envelope    Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, availableAt])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())
}
